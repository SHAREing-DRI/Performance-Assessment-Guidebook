\pgfdeclareimage[height=1.2cm]{SchoolLogo}{SchoolLogo}
\pgfdeclareimage[height=0.2cm]{BlueskyLogo}{BlueskyLogo}

\mode<presentation>


\userightsidebartemplate{0cm}{}

\mode
<all>


     
  
%   \newcommand{\gpltinline}[1]{\lstinline[language=cCCode]�#1�}

  \setbeamertemplate{headline}[text line]
  {
    \vbox{
      \vskip3pt
      \beamerline{
%        \insertsectionnavigationhorizontal{0.72\paperwidth}{}{} 
        \hspace{0.76\paperwidth}
        \hfill \pgfuseimage{SchoolLogo}
      }
      \vspace{-1.0cm}
    }
  }
  
  \setbeamertemplate{footline}[text line]
  {
    \vbox{
      \insertvrule{0.5pt}{black}%
      \vskip1.5pt
      \tinyline{\color{DUpalatine} 
      \pgfuseimage{BlueskyLogo}
      \color{black}
      @tobiasweinzierl.bsky.social \phantom{xxx} \teacher : \brieftitle
		  \hfill \insertframenumber\ / \inserttotalframenumber 
      }
    }
  }


  \usetitlepagetemplate{
        \vbox{}
        \vfill
        \vskip3.5em
        \begin{centering}
          \structure{\huge \lecturetitle}
          \linebreak
          \structure{\small \session}
          \linebreak
          \vspace{1.5cm}
          \structure{\small  \collaborators}
        \end{centering}
        \linebreak
        \structure{\small  \affiliation}
        \linebreak
        \structure{\small  \date}
        \vfill
  }
  
  % 
  % Nur ein Parameter. Das ist dann auch der Section header 
  %
  \renewcommand{\frametitle}[1]{
  \ifthenelse{\boolean{format169}}{
   \vskip3pt \hspace{-0.65cm} \vbox{\structure{\bfseries \Large #1}} \vskip1pt
  }{
   \vskip3pt \hspace{-0.65cm} \vbox{\structure{\bfseries \Large #1}} \vskip10pt
  }
  }
  
  

  %
  % Ein Bild kommt links, rechts steht Inhalt
  %
  % @param #1 Bilddatei
  % @param #2 Bildunterschrift (Urheberrecht) Kann auch leer Klammer sein
  %
  \newenvironment{split-content}[2]
  { 
    \ifthenelse{\boolean{format169}}{
    \begin{minipage}[h]{0.35\textwidth}
      \begin{center}
        \includegraphics[width=0.8\textwidth]{#1} 
        \linebreak
        {
        \footnotesize
        #2
        }
      \end{center}
    \end{minipage}
    \begin{minipage}[h]{0.6\textwidth}
    }
    {
    \begin{minipage}[h]{0.45\textwidth}
      \begin{center}
        \includegraphics[width=0.8\textwidth]{#1} 
        \linebreak
        {
        \footnotesize
        #2
        }
      \end{center}
    \end{minipage}
    \begin{minipage}[h]{0.5\textwidth}
    }
  }
  { 
    \end{minipage} 
  }


  %
  % Citation box. Can also be used for definitions
  %
  % @param Source of citation
  %
  \newenvironment{citation-box}[1]
  {
    \begin{center}
    \begin{minipage}[h]{0.8\textwidth}
    \begin{framed}
    {\color{DUpalatine}#1:}
  }
  {
    \end{framed}
    \end{minipage}
    \end{center}
  }

%
% Insert a black frame with a picture
%
% @param 1: Size of picture relative to page width, e.g. 0.5
% @param 2: Filename of picture
% @param 3: Link/name of picture source
%
\newcommand{\blackframe}[3]{\bgroup
\setbeamercolor{background canvas}{bg=black}
%\setcounter{framenumber}{\value{finalframe}}
\begin{frame}[c,plain]{}
  \begin{center}
    \includegraphics[width=#1\textwidth]{#2}
    \\
    {\footnotesize \href{#3}{\color{white} #3}} 
  \end{center}
\end{frame}
\egroup
}


\newcommand{\whiteframe}[3]{\bgroup
\setbeamercolor{background canvas}{bg=white}
%\setcounter{framenumber}{\value{finalframe}}
\begin{frame}[c,plain]{}
  \begin{center}
    \includegraphics[width=#1\textwidth]{#2}
    \\
    {\footnotesize \href{#3}{\color{black} #3}} 
  \end{center}
\end{frame}
\egroup
}


\newenvironment{notes}{%
    \begin{frame}
      \frametitle{---Notes---}
      \vfill
}{%
      \vfill
    \end{frame}
}


\newcommand{\outline}{
  \ifthenelse{\boolean{insertOutlineSlides}}{
    \begin{frame}
     \frametitle{Outline}
     \vfill 
     \tableofcontents
     \vfill
    \end{frame}
  }{
  }
}



\newcommand{\abstractpage}[1]{\bgroup
\setbeamercolor{background canvas}{bg=white}
%\setcounter{framenumber}{\value{finalframe}}
  \begin{frame}[c,plain]{}
  \frametitle{\small \lecturetitle \\ \footnotesize \teacher}
  \setlength{\parskip}{1em}
  \footnotesize
  #1
  \vfill
  \setcounter{framenumber}{0}
\egroup
}



