\NeedsTeXFormat{LaTeX2e}[1995/12/01]
\ProvidesPackage{durham_lecture}




%
% Usage:
%
% - Include package:
%     \documentclass[8pt,t,pdflatex,notes]{beamer}
%     \usepackage{durham_lecture}
%
%   Please replace the notes with nonotes if you don't want to see notes
%
% - Add four defines:
%     \def\lecturetitle{Software Engineering for the Internet}
%     \def\brieftitle{Software Engineering for the Internet}
%     \def\session{Requirements Engineering}
%     \def\teacher{Dr.~Weinzierl}
%     \def\collaborators{Dr.~Weinzierl}
%     \def\date{1/1/2013}
%
%
% - After \begin{document}, insert
%     \frame{
%       \titlepage
%     }
%
% - Use split-content if you want to have two-column layout
%
% - Use presentationSection instead of section
%
% - If you have source code or pictures within your frame, you might want to 
%   mark it as [fragile]
%
% - If you have a slide with only one picture, you might want to use 
%   \blackframe or \whiteframe. Their arguments are described below.
%
% - If you use the notes environment, please add either
%     \includeversion{notes}
%     \excludeversion{notes}
%
% - If you prefer 16:9, change the document style into 
%   \documentclass[8pt,t,pdflatex,nonotes,aspectratio=169]{beamer}
%   and add
%   \setboolean{format169}{true}
%

